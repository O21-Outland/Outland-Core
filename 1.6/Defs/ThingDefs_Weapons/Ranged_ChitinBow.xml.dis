<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingDef ParentName="OutlandBaseMakeableBow">
		<defName>Outland_ChitinBow</defName>
		<label>chitin bow</label>
		<description>TODO</description>
		<graphicData>
			<texPath>Outland/Weapons/InsectBow</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<equippedAngleOffset>-45</equippedAngleOffset>
		<soundInteract>Bow_Recurve</soundInteract>
		<costList>
			<WoodLog>15</WoodLog>
			<Outland_Chitin>20</Outland_Chitin>
		</costList>
		<statBases>
			<WorkToMake>4000</WorkToMake>
			<Mass>1.3</Mass>
			<AccuracyTouch>0.70</AccuracyTouch>
			<AccuracyShort>0.78</AccuracyShort>
			<AccuracyMedium>0.65</AccuracyMedium>
			<AccuracyLong>0.35</AccuracyLong>
			<RangedWeapon_Cooldown>1.65</RangedWeapon_Cooldown>
		</statBases>
		<weaponTags>
			<li>ChitinRanged</li>
		</weaponTags>
		<weaponClasses>
			<li>Ranged</li>
			<li>RangedLight</li>
		</weaponClasses>
		<recipeMaker>
			<researchPrerequisite>Greatbow</researchPrerequisite>
			<recipeUsers>
				<li>CraftingSpot</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
		</recipeMaker>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Outland_ChitinArrow</defaultProjectile>
				<warmupTime>1.45</warmupTime>
				<range>25.9</range>
				<soundCast>Bow_Recurve</soundCast>
			</li>
		</verbs>
		<tools>
			<li>
				<label>limb</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
	</ThingDef>

	<ThingDef ParentName="OutlandBaseProjectileNeolithic">
		<defName>Outland_ChitinArrow</defName>
		<label>chitin arrow</label>
		<graphicData>
			<texPath>Outland/Projectiles/InsectArrow</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>ArrowHighVelocity</damageDef>
			<damageAmountBase>14</damageAmountBase>
			<stoppingPower>1</stoppingPower>
			<speed>56</speed>
		</projectile>
	</ThingDef>

</Defs>