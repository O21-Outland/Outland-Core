<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<StatDef>
		<defName>Outland_BoneAmount</defName>
		<label>bone amount</label>
		<description>The quantity of bones you will get from butchering this creature.</description>
		<category>BasicsPawn</category>
		<defaultBaseValue>35</defaultBaseValue>
		<toStringStyle>Integer</toStringStyle>
		<hideAtValue>0</hideAtValue>
		<parts>
			<li Class="StatPart_BodySize" />
			<li Class="StatPart_NaturalNotMissingBodyPartsCoverage" />
			<li Class="Outland.StatPart_BoneFactor" />
		</parts>
	</StatDef>

	<StatDef>
		<defName>Outland_ChitinAmount</defName>
		<label>chitin amount</label>
		<description>The quantity of chitin you will get from butchering this creature.</description>
		<category>BasicsPawn</category>
		<defaultBaseValue>35</defaultBaseValue>
		<toStringStyle>Integer</toStringStyle>
		<hideAtValue>0</hideAtValue>
		<parts>
			<li Class="StatPart_BodySize" />
			<li Class="StatPart_NaturalNotMissingBodyPartsCoverage" />
			<li Class="Outland.StatPart_ChitinFactor" />
		</parts>
	</StatDef>

</Defs>